{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "watchPatterns": [
      "server/**",
      "src/**",
      "public/**",
      "package.json",
      "railway.json",
      "Procfile"
    ]
  },
  "deploy": {
    "startCommand": "npm run build && node server/index.js",
    "healthcheckPath": "/api/prices",
    "restartPolicyType": "ON_FAILURE"
  }
}
